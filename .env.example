# 前端页面（留空时默认同源 /api 与 /proxy，经 Vite 代理转发；
# 局域网设备直接访问 http://<本机IP>:5173 即可，无需改成局域网 IP）
# 生产部署若不用同源代理，可显式指定完整地址，例如：
# VITE_API_BASE_URL=http://localhost:3000/api
# VITE_PROXY_URL=http://localhost:5175

# 数据代理（server/proxy-server.mjs）
# PROXY_PORT=5175
# BACKEND_API_URL=http://localhost:3000/api
# AUTH_PROFILE_URL=http://localhost:3000/api/auth/profile
# AUTH_CACHE_TTL_MS=30000
# PROXY_AUTH_DISABLED=1
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# RATE_MAX=30
# RATE_CONSOLE_MAX=10
# DEFAULT_ROW_LIMIT=1000
# MAX_ROW_LIMIT=10000
# QUERY_TIMEOUT_MS=5000

# 数据源凭据（credentialsRef 引用，名称转大写）
# DS_CRED_MYSQL_DEMO_USER=root
# DS_CRED_MYSQL_DEMO_PASS=secret
# DS_CRED_MYSQL_DEMO_DB=demo
# DS_CRED_PG_DEMO_USER=postgres
# DS_CRED_PG_DEMO_PASS=secret
# DS_CRED_PG_DEMO_DB=demo
# DS_CRED_MQTT_DEMO_MQTT_URL=mqtt://localhost:1883
