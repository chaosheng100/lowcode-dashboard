{
  "name": "react-lowcode-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "基于 React 18 的纯前端低代码大屏设计器：拖拽设计、组件联动、一键预览。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "proxy": "node server/proxy-server.mjs",
    "model:obj2gltf": "node scripts/convert-obj.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@react-three/fiber": "^8.18.0",
    "3d-tiles-renderer": "^0.5.0",
    "antd": "^6.5.2",
    "axios": "^1.19.0",
    "cors": "^2.8.5",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.6",
    "eventsource-parser": "^3.1.0",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "meshoptimizer": "^1.2.0",
    "mysql2": "^3.23.2",
    "nanoid": "^6.0.1",
    "openskp": "^0.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-rnd": "^10.5.3",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3",
    "three": "^0.169.0",
    "web-ifc": "^0.0.77",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "obj2gltf": "^3.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
